# Build output
/build/
build/
cmake-build-*/

# CMake user presets / cache
CMakeUserPresets.json

# Every dot-prefixed directory (editor / tool / AI-agent state):
# .vs, .vscode, .idea, .agents, .reasonix, .cache, ...
# NOTE: git never ignores .git itself. This pattern also matches .github,
# so it is re-included below - delete that line if you want CI folders ignored.
.*/
!.github/

# Reasonix tooling config (machine-specific)
reasonix.toml

# OS
.DS_Store
Thumbs.db

# Dear ImGui runtime state (window layout / docking)
imgui.ini
